{
  "name": "learnsphere-ai",
  "version": "2.0.0",
  "private": true,
  "engines": { "node": ">=20" },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node tests/extract.test.mjs && node tests/api.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "multer": "^2.5.0",
    "pdf-parse": "1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.5"
  }
}
